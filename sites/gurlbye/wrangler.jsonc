{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "smat-gurlbye",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [{
    "name": "FORM_RATE_LIMITER",
    "namespace_id": "301133",
    "simple": { "limit": 5, "period": 60 }
  }],
  "send_email": [{"name": "EMAIL", "destination_address": "jamonwidit@plushtrap.com"}]
}
